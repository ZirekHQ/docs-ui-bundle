{{! Add additional meta tags here}}
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">

{{! OpenGraphProtocol }}
<meta property="og:type" content="article">
{{#if site.title}}<meta property="og:site_name" content="{{site.title}}">{{/if}}
<meta property="og:title" content="{{{detag (or page.title 'Untitled')}}}">
{{#if page.description}}<meta property="og:description" content="{{page.description}}">{{/if}}

<meta property="og:image" content="{{ site.url}}{{uiRootPath}}/img/docs_logo.png">

{{#if page.attributes.creation-date}}<meta property="og:article:published_time" content="{{{page.attributes.creation-date}}}">{{/if}}
{{#if page.attributes.last-updated}}<meta property="og:article:modified_time" content="{{{page.attributes.last-updated}}}">{{/if}}
{{#if page.keywords}}<meta property="og:article:tag" content="{{page.keywords}}">{{/if}}
